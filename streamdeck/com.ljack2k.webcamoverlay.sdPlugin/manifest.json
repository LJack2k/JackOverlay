{
  "UUID": "com.ljack2k.webcamoverlay",
  "Name": "Webcam Overlay",
  "Version": "1.3.0.0",
  "Author": "LJack2k",
  "Description": "Control the floating webcam overlay — show, hide, maximize, window mode, opacity and corner radius. Each button lights up while the overlay is in that state.",
  "Category": "Webcam Overlay",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/port.html",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "UUID": "com.ljack2k.webcamoverlay.show",
      "Name": "Show",
      "Tooltip": "Show the overlay. Lit while the overlay is visible.",
      "Icon": "imgs/actions/show/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/show/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/show/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.hide",
      "Name": "Hide",
      "Tooltip": "Hide the overlay. Lit while the overlay is hidden.",
      "Icon": "imgs/actions/hide/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/hide/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/hide/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.maximize",
      "Name": "Maximize",
      "Tooltip": "Maximize the overlay. Lit while the overlay is maximized.",
      "Icon": "imgs/actions/maximize/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/maximize/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/maximize/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.window",
      "Name": "Window Mode",
      "Tooltip": "Return the overlay to window mode. Lit while the overlay is windowed.",
      "Icon": "imgs/actions/window/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/window/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/window/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.topleft",
      "Name": "Corner: Top Left",
      "Tooltip": "Park the overlay in the top-left corner. Lit while it is there.",
      "Icon": "imgs/actions/topleft/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/topleft/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/topleft/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.topright",
      "Name": "Corner: Top Right",
      "Tooltip": "Park the overlay in the top-right corner. Lit while it is there.",
      "Icon": "imgs/actions/topright/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/topright/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/topright/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.bottomleft",
      "Name": "Corner: Bottom Left",
      "Tooltip": "Park the overlay in the bottom-left corner. Lit while it is there.",
      "Icon": "imgs/actions/bottomleft/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/bottomleft/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/bottomleft/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.bottomright",
      "Name": "Corner: Bottom Right",
      "Tooltip": "Park the overlay in the bottom-right corner. Lit while it is there.",
      "Icon": "imgs/actions/bottomright/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "imgs/actions/bottomright/off", "TitleAlignment": "bottom" },
        { "Image": "imgs/actions/bottomright/on", "TitleAlignment": "bottom" }
      ]
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.opacity",
      "Name": "Opacity",
      "Tooltip": "Rotate to adjust overlay opacity; press to reset to 100%",
      "Icon": "imgs/actions/opacity/icon",
      "Controllers": ["Keypad", "Encoder"],
      "States": [
        { "Image": "imgs/actions/opacity/key", "TitleAlignment": "bottom" }
      ],
      "Encoder": {
        "Icon": "imgs/actions/opacity/encoder",
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust opacity",
          "Push": "Reset to 100%",
          "Touch": "Reset to 100%"
        }
      }
    },
    {
      "UUID": "com.ljack2k.webcamoverlay.radius",
      "Name": "Corner Radius",
      "Tooltip": "Rotate to adjust corner radius; press to reset to 16 px",
      "Icon": "imgs/actions/radius/icon",
      "Controllers": ["Keypad", "Encoder"],
      "States": [
        { "Image": "imgs/actions/radius/key", "TitleAlignment": "bottom" }
      ],
      "Encoder": {
        "Icon": "imgs/actions/radius/encoder",
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust corner radius",
          "Push": "Reset to 16 px",
          "Touch": "Reset to 16 px"
        }
      }
    }
  ]
}
