# Dependencies — restore with `npm install` (see README)
node_modules/

# Per-machine runtime state. main.js recreates this with defaults on first run,
# and it holds this machine's window position/size, so it should not be shared.
/config.json

# Runtime logs — the overlay's own log plus the Stream Deck plugin's
logs/
*.log
*.log.old

# Transient / recovery artefacts from config writes
/config.json.tmp
/config.json.corrupt

# Editor / OS cruft
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
